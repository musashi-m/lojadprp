.env*.local
web/.env*.local
!web/.env.example

# Local SQLite databases (created automatically on startup)
*.db
*.db-wal
*.db-shm
web/data/*.db
web/data/*.db-wal
web/data/*.db-shm

# OS & Logs
.DS_Store
Thumbs.db
*.log
npm-debug.log*

# Antigravity / Agents local cache
.agents/
.gemini/

