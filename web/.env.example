# ==============================================================
# Distrito Paulista RP - Configurações do Backend da Loja
# ==============================================================

# 1. Mercado Pago Credentials
# Obtenha seu Access Token em: https://www.mercadopago.com.br/developers/panel/app
# Em ambiente de teste/desenvolvimento deixe 'mock' ou preencha com seu token real 'APP_USR-...'
MERCADOPAGO_ACCESS_TOKEN=mock

# Chave secreta de Webhook do Mercado Pago (para verificação de assinatura)
MERCADOPAGO_WEBHOOK_SECRET=

# URL pública da sua loja (onde o Mercado Pago enviará os Webhooks)
# Exemplo em produção: https://loja.distritopaulistarp.com.br
# Exemplo em desenvolvimento local com ngrok: https://xxxx.ngrok-free.app
STORE_URL=http://localhost:3000

# 2. FiveM In-Game Delivery Security
# Segredo compartilhado entre a loja web e o resource Lua do FiveM (dprp_loja)
# Mantenha essa chave segura e confidencial!
FIVEM_API_SECRET=dprp_fivem_secret_change_me_in_prod

# 3. Database (SQLite Nativo de Alto Desempenho)
DATABASE_FILE_PATH=./data/store.db

# 4. Painel Administrativo do Dono da Loja (Acesso Secreto /admin)
ADMIN_SECRET=dprp_admin_secret_key_change_in_prod

# 5. Google OAuth - Login Seguro do Proprietário
# Obtenha suas chaves em: https://console.cloud.google.com/apis/credentials
# URI de Redirecionamento autorizada: http://localhost:3000/api/admin/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# (Opcional) Travar o acesso exclusivamente neste e-mail Google exato (Whitelist rígida)
ADMIN_OWNER_EMAIL=



# 6. Discord OAuth2 - Login de Clientes da Loja
# Obtenha suas credenciais em: https://discord.com/developers/applications
# Redirecionamento autorizado no Discord Developer Portal: http://localhost:3000/api/auth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=


# 7. Discord Webhook - Notificação de Vendas (Embed)
# Crie um Webhook no seu canal do Discord (Configurações do Canal > Integrações > Webhooks)
DISCORD_WEBHOOK_URL=
