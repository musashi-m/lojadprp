# ==============================================================
# Distrito Paulista RP - Configurações do Backend da Loja
# ==============================================================

# 1. Mercado Pago Credentials
# Obtenha seu Access Token em: https://www.mercadopago.com.br/developers/panel/app
# Em ambiente de teste/desenvolvimento deixe 'mock' ou preencha com seu token real 'APP_USR-...'
MERCADOPAGO_ACCESS_TOKEN=mock

# Chave secreta de Webhook do Mercado Pago (para verificação de assinatura)
MERCADOPAGO_WEBHOOK_SECRET=

# URL pública da sua loja (onde o Mercado Pago enviará os Webhooks)
# Exemplo em produção: https://loja.distritopaulistarp.com.br
# Exemplo em desenvolvimento local com ngrok: https://xxxx.ngrok-free.app
STORE_URL=http://localhost:3000

# 2. FiveM In-Game Delivery Security
# Segredo compartilhado entre a loja web e o resource Lua do FiveM (dprp_loja)
# Mantenha essa chave segura e confidencial!
FIVEM_API_SECRET=dprp_fivem_secret_change_me_in_prod

# 3. Database (SQLite Nativo de Alto Desempenho)
DATABASE_FILE_PATH=./data/store.db

